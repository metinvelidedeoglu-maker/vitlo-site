DirectoryIndex index.html
Options -Indexes

RewriteEngine On

# Broken homepage hero asset: serve the known-good Vitlo fan image instead.
RewriteRule ^vitlo-hero-v2\.png$ urun-detaylari/assets/images/TUNEL_AXF_Tunel_Jet_Fani.webp [L]

# Old .html URLs -> clean URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]|$) [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]|$) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Clean URLs -> existing .html files. Physical directories such as /blog/
# are left alone, so Apache serves /blog/index.html via DirectoryIndex.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /index.html
