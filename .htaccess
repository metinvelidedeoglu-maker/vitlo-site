DirectoryIndex index.html
Options -Indexes

RewriteEngine On

# Product page: load the clickable-card CSS wrapper while keeping the original stylesheet intact.
RewriteCond %{QUERY_STRING} !(^|&)base=1(&|$) [NC]
RewriteRule ^assets/index-B0UnD_Ry\.css$ assets/product-click.css [L]

# Product category cards -> matching model sections.
RewriteCond %{QUERY_STRING} ^kategori=aksiyal-fanlar$ [NC]
RewriteRule ^iletisim/?$ /urunler#modeller-aksiyal-fanlar [R=302,L,NE]
RewriteCond %{QUERY_STRING} ^kategori=cati-tipi-fanlar$ [NC]
RewriteRule ^iletisim/?$ /urunler#modeller-cati-tipi-fanlar [R=302,L,NE]
RewriteCond %{QUERY_STRING} ^kategori=duman-egzost-fanlari$ [NC]
RewriteRule ^iletisim/?$ /urunler#modeller-duman-egzost-fanlari [R=302,L,NE]
RewriteCond %{QUERY_STRING} ^kategori=exproof-fanlar$ [NC]
RewriteRule ^iletisim/?$ /urunler#modeller-exproof-fanlar [R=302,L,NE]
RewriteCond %{QUERY_STRING} ^kategori=hucreli-fanlar$ [NC]
RewriteRule ^iletisim/?$ /urunler#modeller-hucreli-fanlar [R=302,L,NE]
RewriteCond %{QUERY_STRING} ^kategori=kanal-tipi-fanlar$ [NC]
RewriteRule ^iletisim/?$ /urunler#modeller-kanal-tipi-fanlar [R=302,L,NE]
RewriteCond %{QUERY_STRING} ^kategori=salyangoz-fanlar$ [NC]
RewriteRule ^iletisim/?$ /urunler#modeller-salyangoz-fanlar [R=302,L,NE]

# Homepage hero: serve the cleaned WebP asset.
RewriteRule ^vitlo-hero-v2\.png$ vitlo-hero-clean-20260817.webp [L]

# Avoid stale hero caching while the replacement settles.
<IfModule mod_headers.c>
<FilesMatch "^(vitlo-hero-v2\.png|vitlo-hero-clean-20260817\.webp)$">
Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
Header set Pragma "no-cache"
Header set Expires "0"
</FilesMatch>
</IfModule>

# Old .html URLs -> clean URLs.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]|$) [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]|$) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Clean URLs -> existing .html files. Physical directories such as /blog/
# are left alone, so Apache serves /blog/index.html via DirectoryIndex.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /index.html
