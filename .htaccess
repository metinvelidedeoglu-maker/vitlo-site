DirectoryIndex index.html
Options -Indexes

RewriteEngine On

# Eski .html URL'lerini temiz URL'lere kalici yonlendir
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]|$) [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]|$) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Temiz URL'leri mevcut .html dosyalarindan dahili olarak sun.
# Ayni adli bir klasor bulunsa bile (ornegin blog/) HTML sayfasini onceliklendir.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /index.html
